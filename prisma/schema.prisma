// =============================================
// Prisma Schema - Inventaris LDTE
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// Tabel Autentikasi & Sesi
// =============================================

model User {
  id              BigInt        @id @default(autoincrement())
  name            String        @db.VarChar(255)
  email           String        @unique @db.VarChar(255)
  role            String        @default("petugas") @db.VarChar(255)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  password        String        @db.VarChar(255)
  rememberToken   String?       @map("remember_token") @db.VarChar(100)
  createdAt       DateTime?     @default(now()) @db.Timestamptz @map("created_at")
  updatedAt       DateTime?     @updatedAt @db.Timestamptz @map("updated_at")

  tambahPetugas    TambahPetugas?
  assignments      Assignment[]  @relation("AssignmentUser")
  assignedByAssign Assignment[]  @relation("AssignedByUser")
  sessions         Session[]
  activityLogs     ActivityLog[]

  @@index([createdAt], map: "idx_users_created_at")
  @@map("users")
}

model PasswordResetToken {
  email     String    @id @db.VarChar(255)
  token     String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @db.Timestamptz @map("created_at")

  @@map("password_reset_tokens")
}

model Session {
  id           String  @id @db.VarChar(255)
  userId       BigInt? @map("user_id")
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  userAgent    String? @map("user_agent") @db.Text
  payload      String  @db.Text
  lastActivity Int

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([lastActivity], map: "idx_sessions_last_activity")
  @@map("sessions")
}

// =============================================
// Tabel Cache & Queue
// =============================================

model Cache {
  key        String @id @db.VarChar(255)
  value      String @db.Text
  expiration Int

  @@index([expiration], map: "idx_cache_expiration")
  @@map("cache")
}

model CacheLock {
  key        String @id @map("key") @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@map("cache_locks")
}

// =============================================
// Tabel Inventaris
// =============================================

model Barang {
  id         BigInt    @id @default(autoincrement())
  namaBarang String    @unique @map("nama_barang") @db.VarChar(255)
  createdAt  DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt  DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  unitBarangs UnitBarang[]

  @@index([namaBarang], map: "idx_barangs_nama_barang")
  @@index([createdAt], map: "idx_barangs_created_at")
  @@map("barangs")
}

model RuangLab {
  id        BigInt    @id @default(autoincrement())
  namaRuang String    @map("nama_ruang") @db.VarChar(255)
  deskripsi String?   @db.Text
  createdAt DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  mejas       Meja[]
  unitBarangs UnitBarang[]
  assignments Assignment[]

  @@index([createdAt], map: "idx_ruang_labs_created_at")
  @@map("ruang_labs")
}

model Meja {
  id         BigInt    @id @default(autoincrement())
  ruangLabId BigInt    @map("ruang_lab_id")
  meja       String    @db.VarChar(255)
  createdAt  DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt  DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  ruangLab    RuangLab     @relation(fields: [ruangLabId], references: [id], onDelete: Restrict)
  unitBarangs UnitBarang[]

  @@unique([meja, ruangLabId])
  @@index([ruangLabId], map: "idx_mejas_ruang_lab_id")
  @@index([createdAt], map: "idx_mejas_created_at")
  @@map("mejas")
}

model UnitBarang {
  id            BigInt    @id @default(autoincrement())
  barangId      BigInt    @map("barang_id")
  kodeBarang    String    @map("kode_barang") @db.VarChar(255)
  kondisiBarang String    @map("kondisi_barang") @db.VarChar(255)
  status        String    @default("Tersedia") @db.VarChar(255)
  ruangLabId    BigInt?   @map("ruang_lab_id")
  mejaId        BigInt?   @map("meja_id")
  createdAt     DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  barang      Barang       @relation(fields: [barangId], references: [id], onDelete: Cascade)
  ruangLab    RuangLab?    @relation(fields: [ruangLabId], references: [id], onDelete: Restrict)
  meja        Meja?        @relation(fields: [mejaId], references: [id], onDelete: Restrict)
  mutasiStoks MutasiStok[]

  @@unique([kodeBarang, ruangLabId])
  @@index([kodeBarang], map: "idx_unit_barangs_kode_barang")
  @@index([status], map: "idx_unit_barangs_status")
  @@index([kondisiBarang], map: "idx_unit_barangs_kondisi_barang")
  @@index([ruangLabId], map: "idx_unit_barangs_ruang_lab_id")
  @@index([barangId], map: "idx_unit_barangs_barang_id")
  @@index([mejaId], map: "idx_unit_barangs_meja_id")
  @@index([barangId, mejaId], map: "idx_unit_barangs_barang_meja")
  @@map("unit_barangs")
}

model MutasiStok {
  id           BigInt    @id @default(autoincrement())
  unitBarangId BigInt    @map("unit_barang_id")
  tipe         String    @db.VarChar(255)
  tanggal      DateTime  @db.Date
  keterangan   String?   @db.Text
  createdAt    DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt    DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  unitBarang UnitBarang @relation(fields: [unitBarangId], references: [id], onDelete: Cascade)

  @@index([tipe], map: "idx_mutasi_stoks_tipe")
  @@index([createdAt], map: "idx_mutasi_stoks_created_at")
  @@index([tipe, createdAt], map: "idx_mutasi_stoks_tipe_created_at")
  @@map("mutasi_stoks")
}

// =============================================
// Tabel Penugasan & Profil
// =============================================

model TambahPetugas {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @unique @map("user_id")
  noTelp    String?   @map("no_telp") @db.VarChar(255)
  alamat    String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tambah_petugas")
}

model Assignment {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  ruangLabId BigInt    @map("ruang_lab_id")
  isActive   Boolean   @default(true) @map("is_active")
  assignedBy BigInt?   @map("assigned_by")
  createdAt  DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt  DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  user           User     @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  ruangLab       RuangLab @relation(fields: [ruangLabId], references: [id], onDelete: Cascade)
  assignedByUser User?    @relation("AssignedByUser", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_assignments_user_id")
  @@index([ruangLabId], map: "idx_assignments_ruang_lab_id")
  @@index([isActive], map: "idx_assignments_active")
  @@map("assignments")
}

// =============================================
// Tabel Activity Log
// =============================================

model ActivityLog {
  id          BigInt    @id @default(autoincrement())
  logName     String?   @map("log_name") @db.VarChar(255)
  description String    @db.Text
  subjectType String?   @map("subject_type") @db.VarChar(255)
  subjectId   BigInt?   @map("subject_id")
  event       String?   @db.VarChar(255)
  causerType  String?   @map("causer_type") @db.VarChar(255)
  causerId    BigInt?   @map("causer_id")
  properties  Json?
  batchUuid   String?   @map("batch_uuid")
  createdAt   DateTime? @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime? @updatedAt @db.Timestamptz @map("updated_at")

  user User? @relation(fields: [causerId], references: [id], onDelete: SetNull)

  @@index([logName], map: "idx_activity_logs_log_name")
  @@index([event], map: "idx_activity_logs_event")
  @@index([createdAt], map: "idx_activity_logs_created_at")
  @@index([subjectType, subjectId], map: "idx_activity_logs_subject")
  @@index([causerType, causerId], map: "idx_activity_logs_causer")
  @@map("activity_logs")
}